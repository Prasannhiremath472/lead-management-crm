MYSQL_HOST = "localhost"
MYSQL_PORT = "3306"
MYSQL_USER = "your_mysql_user"
MYSQL_PASSWORD = "your_mysql_password"
MYSQL_DATABASE = "your_mysql_database"
#RESEND_API = "your resend_api"
#OPENAI_API_KEY = "your open_ai api key"
JWT_SECRET= "your_private_jwt_secret_key"
NODE_ENV = "production"
OPENSSL_CONF='/dev/null'
PUBLIC_SERVER_FILE="http://localhost:8888/"
APP_EMAIL="noreply@your-domain.com"
APP_BASE_URL="https://your-domain.com"
# AGPLv3 compliance: this app's source (incl. your modifications) must be
# reachable by your users. Set this to the Git repo URL where you publish it.
SOURCE_CODE_URL="https://github.com/Prasannhiremath472/lead-management-crm"
# PDF generation uses puppeteer-core, which needs an existing Chrome/Chromium
# binary on the server (it does not bundle one). Find one on your host, e.g.
# `which chromium-browser` or `which google-chrome` via SSH, and set its path
# here. If left unset, PDF generation will fail until this is configured.
PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium-browser"
